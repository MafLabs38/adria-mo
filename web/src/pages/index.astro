---
import PublicConstats from '../components/public/PublicConstats';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withSlash } from '../lib/paths';
import { dataUrl } from '../lib/snapshot';

const base = withSlash(import.meta.env.BASE_URL);
const data = dataUrl(base, import.meta.env.PUBLIC_ADRIAMO_DATA_URL);
---

<BaseLayout
  title="Constats de l'immeuble · Adria MO"
  description="Les défauts constatés dans les parties communes de l'immeuble, leurs photos et où en sont les travaux."
>
  <h1 class="font-display text-3xl font-extrabold text-brand-900">Constats de l'immeuble</h1>
  <p class="mt-2 text-base">
    Les défauts constatés dans les parties communes, datés et illustrés par des photos, et où en sont les travaux.
  </p>
  <section aria-labelledby="constats-title" class="mt-6">
    <h2 id="constats-title" class="mb-3 font-display text-xl font-bold text-brand-800">
      Constats en cours
    </h2>
    <PublicConstats client:load data={data} detail={`${base}constat/`} />
  </section>
</BaseLayout>
