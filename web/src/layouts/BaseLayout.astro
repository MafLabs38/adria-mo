---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Keeps the page out of search engines (the administration). */
  noindex?: boolean;
  /** Links the manifest that makes the administration installable on a phone's home screen (spec §4.1). */
  app?: boolean;
}

const { title, description, noindex = false, app = false } = Astro.props;
// The site may live under a path of another site (spec §10.5): every link starts from the base, never from '/'.
const base = import.meta.env.BASE_URL;
const root = base.replace(/\/$/, '');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${root}/favicon.svg`} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {app && <link rel="manifest" href={`${root}/admin/manifest.webmanifest`} />}
    {app && <meta name="theme-color" content="#0a7359" />}
    {app && <link rel="apple-touch-icon" href={`${root}/admin/icons/icon-192.png`} />}
    <title>{title}</title>
  </head>
  <body class="min-h-dvh bg-brand-50 text-slate-900">
    <header class="bg-brand-700 text-white">
      <div class="mx-auto max-w-3xl px-4 py-3">
        <a href={base} class="font-display text-xl font-extrabold tracking-tight">
          Adria MO
        </a>
        <p class="text-sm text-brand-100">Les constats des parties communes</p>
      </div>
    </header>
    <main class="mx-auto max-w-3xl px-4 py-6">
      <slot />
    </main>
  </body>
</html>
